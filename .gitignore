# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
frontend/coverage

# next.js
frontend/.next/
frontend/out/

# production
frontend/build

# misc
.DS_Store
*.pem
.venv/
*.pdf
*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
frontend/.env*
.env*

# vercel
frontend/.vercel
.vercel

# trigger.dev build artifacts
frontend/.trigger/

# temporary scrape/tool outputs
frontend/.firecrawl/
frontend/.tmp/
frontend/.tmp_val

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts
